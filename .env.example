# Copiá este archivo como .env.local y completá los valores.
# Solo variables públicas: nunca pongas aquí la clave service_role.

# Sin estas dos, la app arranca en modo demo con localStorage.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# URL pública usada en enlaces e invitaciones con QR.
# En local, para probar desde un celular: http://TU_IP_LOCAL:5173
VITE_PUBLIC_APP_URL=http://localhost:5173
